function parse(wb){
 const hh=[];sheet(wb,'HHEE').forEach(r=>{
  let f=pick(r,'FECHA',1);if(typeof f==='string')f=Date.parse(f)/864e5+25569;if(typeof f!=='number'||isNaN(f))return;
  let h=pick(r,'CANTIDAD DE HORAS');
